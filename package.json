{
  "name": "claude-work-desk",
  "version": "0.15.0",
  "description": "A file-handoff desk between your Claude Code workspace and your desktop, on Windows/WSL and macOS: tree, preview, and an _inbox drop window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "mermaid": "^11.16.1"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "mammoth": "^1.7.2",
    "marked": "^12.0.2",
    "pdfjs-dist": "^5.4.530",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.tact0225.claude-work-desk",
    "productName": "claude-work Desk",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "search-worker.js",
      "search-engine.js",
      "wikilink.js",
      "folder-color.js",
      "config.json",
      "renderer/**",
      "!node_modules/@napi-rs/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "claude-work-desk-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "claude-work-desk-${version}-mac.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "tact0225",
      "repo": "claude-work-desk",
      "releaseType": "release"
    }
  }
}
